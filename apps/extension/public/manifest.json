{
  "manifest_version": 3,
  "name": "Allhere — Web resource library",
  "version": "0.1.0",
  "description": "Collect and review images, links, media, and file URLs from the pages you visit.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Allhere"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
