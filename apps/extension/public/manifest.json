{
  "manifest_version": 3,
  "name": "Allhere — Web resource library",
  "version": "0.1.1",
  "description": "Collect and review images, links, media, and file URLs from the pages you visit.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/allhere-16.png",
    "32": "icons/allhere-32.png",
    "48": "icons/allhere-48.png",
    "128": "icons/allhere-128.png"
  },
  "permissions": ["tabs", "scripting", "sidePanel", "storage", "unlimitedStorage", "downloads", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Allhere",
    "default_icon": {
      "16": "icons/allhere-16.png",
      "32": "icons/allhere-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
